# ===============================================
# Official Gazette AI Tracker & Audit System - Environment Variables
# ===============================================

# 1. PostgreSQL Database Configuration
POSTGRES_DB=gazette_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
DB_HOST=postgres

# 2. n8n Workflow Engine Configuration
N8N_HOST=localhost
N8N_PORT=5678
GENERIC_TIMEZONE=Europe/Istanbul
WEBHOOK_URL=http://localhost:5678/
N8N_WEBHOOK_URL=http://localhost:5678/

# 3. LLM / AI Model Configuration (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# 4. Firecrawl Scraper Configuration
FIRECRAWL_API_KEY=your_firecrawl_api_key_here
FIRECRAWL_API_URL=https://api.firecrawl.dev

# 5. Gmail API (Google Cloud Console OAuth2) Configuration
GMAIL_CLIENT_ID=your_client_id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your_client_secret

# 6. Fallback SMTP Notification Settings (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=notifications@example.com
SMTP_PASS=app_password_here
SMTP_FROM="Gazette AI Tracker <notifications@example.com>"